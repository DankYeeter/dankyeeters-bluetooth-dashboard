<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      RECORD_AUDIO exists only for AcousticEqTest, which plays a tone and
      records it back through the mic to prove the equaliser is in the signal
      path. Without this declaration AndroidJUnitRunner cannot auto-grant the
      permission, AudioRecord returns silence, and the test fails for a reason
      that has nothing to do with the EQ. androidTest-only: it never reaches
      the shipped app.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      MODIFY_AUDIO_SETTINGS lets the global-mix test attach a DynamicsProcessing
      effect to session 0 (the output mix), the same permission and path the
      shipped GlobalAttachmentStrategy uses. Without it the global attach is
      refused and boosting_a_band_on_the_global_mix_raises_it_in_the_air can only
      report "unavailable", never a real verdict.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

</manifest>
