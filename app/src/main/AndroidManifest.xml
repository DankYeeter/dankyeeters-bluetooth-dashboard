<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET, and it is worth writing down why, because this project went
      years without it and the old comment here said it never would.

      It is not for the internet. Android gates *socket creation itself* behind
      this permission - loopback included - and the app needs a socket to reach
      the debugging service running on this very phone. That is the only way to
      start the privileged helper without plugging into a computer, which is
      what makes codec control and the Tidal equaliser work after a reboot.

      What the app does with it is deliberately boxed in:
        - Only the port number ever comes from the network announcement. The
          connection itself always goes to 127.0.0.1, never to the advertised
          address, so no packet can leave the device even if something else on
          the network claims to be an adb daemon. See AdbPortDiscovery.
        - There is no code anywhere in this project that talks to a remote host.
          No HTTP client, no analytics, no crash reporter, no dependency that
          brings one.

      The honest cost: this used to be a structural guarantee - "cannot send" -
      and it is now a promise backed by review. That trade was Daniel's call,
      made knowingly, and the app explains it before the first connection.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      QUERY_ALL_PACKAGES: needed for the "these apps could have their own EQ"
      check, which has to look at every installed app — an equaliser we have
      never heard of is exactly the one worth warning about, and a fixed
      <queries> list can only ever find the ones we already knew.

      Play Store policy restricts this permission to a short list of app types.
      It is granted here because this app is explicitly never going to the Play
      Store (see PLAN.md non-goals): local git and a sideloaded APK, no store
      listing, no distribution. The package list is read, tiered, shown, and
      discarded when the process ends — it is never stored and never sent.

      That last sentence used to lean on there being no INTERNET permission at
      all. There is one now, for the loopback connection to this phone's own
      debugging service, so the claim rests on review instead of on a locked
      door: no code in this project addresses a remote host.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      Kept even though QUERY_ALL_PACKAGES makes it redundant today: if that
      permission is ever restricted or revoked, the high-confidence tiers still
      work. The <intent> element keeps the "declares an equalizer panel" tier
      alive, and the explicit packages keep the vendor-companion tier alive.

      Those companion apps run their equaliser inside the headphone, where no
      audio-effect scan can see it, so the only detectable signal is that the
      app is installed.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
        <package android:name="com.naimaudio.naim.std" />
        <package android:name="com.sony.songpal.mdr" />
        <package android:name="com.bose.monet" />
        <package android:name="com.bose.bosemusic" />
        <package android:name="com.sennheiser.control" />
        <package android:name="com.sennheiser.smartcontrol" />
        <package android:name="com.jbl.headphones" />
        <package android:name="com.beoplay.bang_olufsen" />
        <package android:name="com.anker.soundcore" />
        <package android:name="com.libratone.androidapp" />
        <package android:name="com.nothing.smartcenter" />
        <package android:name="com.jabra.sound" />
    </queries>

    <application
        android:name=".BtDashboardApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.BtDashboard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BtDashboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            How the privileged helper hands its Binder to the app. Exported
            because the caller runs as a different uid (shell), which is also
            why the provider checks both the calling uid and a token the app
            generated - see PrivilegedProvider. A socket cannot be used here:
            SELinux denies untrusted_app -> shell connectto, measured on the
            device.
        -->
        <provider
            android:name=".privileged.PrivilegedProvider"
            android:authorities="dev.dankyeeter.btdashboard.privileged"
            android:enabled="true"
            android:exported="true" />

        <!--
            Receives the pairing code typed into the notification. Not exported:
            the only sender is a PendingIntent this app created, and nothing
            outside has business starting a pairing attempt.
        -->
        <receiver
            android:name=".privileged.adb.PairingCodeReceiver"
            android:exported="false" />

    </application>
</manifest>
