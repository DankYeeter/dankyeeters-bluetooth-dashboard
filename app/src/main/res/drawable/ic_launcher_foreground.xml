<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: gold headphone silhouette with a waveform between
  the cups. Everything stays inside the 66x66 safe zone (centre 54,54) so no
  launcher mask can clip it.

  Gold #C9A227 is the Edgy accent from ui/theme/Theme.kt — the launcher and the
  app read as the same object.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Headband -->
    <path
        android:pathData="M31,60 V51 A23,23 0 0 1 77,51 V60"
        android:strokeColor="#FFC9A227"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Left cup -->
    <path
        android:pathData="M27,58 h6 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-6 a4,4 0 0 1 -4,-4 v-10 a4,4 0 0 1 4,-4 z"
        android:fillColor="#FFC9A227" />

    <!-- Right cup -->
    <path
        android:pathData="M81,58 h-6 a3,3 0 0 0 -3,3 v12 a3,3 0 0 0 3,3 h6 a4,4 0 0 0 4,-4 v-10 a4,4 0 0 0 -4,-4 z"
        android:fillColor="#FFC9A227" />

    <!-- Waveform between the cups: the audio the app actually shapes -->
    <path
        android:pathData="M44,71 V64 M50,75 V60 M56,78 V57 M62,73 V62 M68,69 V66"
        android:strokeColor="#FFC9A227"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
